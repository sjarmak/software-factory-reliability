
# Agent and issue-tracker scaffolding. Local tooling, not part of the
# published kit: bd's Dolt database, its git hooks, its issue export (which
# carries private working context), and the config each agent harness writes
# into the repository. Everything here stays on disk and keeps working
# locally; a fresh clone re-creates it with `bd init` and whichever harness
# you run.
.agents/
.beads/
.claude/
.codex/
.cursor/
.dolt/
*.db
.beads-credential-key
*.gate.lock*

# OS noise
.DS_Store

# Build and run outputs
out/
__pycache__/
.pytest_cache/
*.pyc

# Local drafts, not for publication
essay/
